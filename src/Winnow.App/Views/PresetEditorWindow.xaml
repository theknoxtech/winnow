<Window x:Class="Winnow.App.Views.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Presets"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        MinWidth="640" MinHeight="420">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="160" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- ============ Preset list ============ -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Presets" FontWeight="SemiBold" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Add" Style="{StaticResource FlatButton}" Command="{Binding AddCommand}" />
                <Button Content="Clone" Style="{StaticResource FlatButton}" Command="{Binding CloneCommand}" />
                <Button Content="Delete" Style="{StaticResource FlatButton}" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     BorderBrush="{StaticResource BorderBrushSoft}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding DisplayName}" />
                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
                                <Run Text="{Binding Group, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Origin, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrushSoft}" />

        <!-- ============ Detail ============ -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
            <!-- Bound to Selected, so the panel is simply empty when nothing is selected. -->
            <StackPanel DataContext="{Binding Selected}">
                <TextBlock Text="Label" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Text="Group" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                         ToolTip="Presets are colour-coded by group. A new group gets its own colour automatically." />

                <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,8"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Shown as the button's tooltip. Worth noting here if the preset's event IDs are shared with unrelated sources." />

                <TextBlock Text="Message filter (optional)" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBox Text="{Binding MessageFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                         ToolTip="Applied to the message text after the query runs. Use when an Event ID is shared by several sources and only the message distinguishes them." />

                <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" Margin="0,0,0,10" />

                <TextBlock Text="Clauses" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock Text="Each clause queries one log. Results from every clause are merged and sorted by time."
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" />

                <ItemsControl ItemsSource="{Binding Clauses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                    Padding="6" Margin="0,0,0,6" CornerRadius="2">
                                <StackPanel>
                                    <TextBlock Text="Log name" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding LogName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6" />

                                    <TextBlock Text="Event IDs (comma-separated, blank = all)" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding EventIdsText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6" />

                                    <TextBlock Text="Providers (comma-separated, optional)" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding ProvidersText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Scopes the clause to specific sources. Important when a low-numbered Event ID is reused across unrelated providers." />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Actions ============ -->
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Add Clause" Style="{StaticResource FlatButton}" Command="{Binding AddClauseCommand}" />
                <Button Content="Remove Clause" Style="{StaticResource FlatButton}" Command="{Binding RemoveClauseCommand}" />
                <Button Content="Test" Style="{StaticResource FlatButton}" Command="{Binding TestCommand}"
                        ToolTip="Runs this preset now and reports how many events it matches." />
                <Button Content="Reset to built-in" Style="{StaticResource FlatButton}" Command="{Binding ResetCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Import…" Style="{StaticResource FlatButton}" Command="{Binding ImportCommand}" />
                <Button Content="Export…" Style="{StaticResource FlatButton}" Command="{Binding ExportCommand}" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="OnSave" />
                <Button Content="Cancel" Style="{StaticResource FlatButton}" MinWidth="80" Click="OnCancel" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
